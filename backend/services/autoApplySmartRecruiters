require('dotenv').config();
const { ChatOpenAI } = require('@langchain/openai');
const { HyperAgent } = require('@hyperbrowser/agent');
const path = require('path');
const fs = require('fs');

function normalize(s) {
  return typeof s === 'string'
    ? s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim()
    : '';
}
const randomDelay = (page, min, max) =>
  page.waitForTimeout(Math.floor(Math.random() * (max - min + 1)) + min);

function calculateOverlapScore(a, b) {
  if (!a || !b) return 0;
  const wa = new Set(a.split(' ').filter((w) => w.length > 1));
  const wb = new Set(b.split(' ').filter((w) => w.length > 1));
  if (!wa.size || !wb.size) return 0;
  let common = 0;
  for (const w of wb) if (wa.has(w)) common++;
  return common / wa.size;
}

async function applyToSmartRecruiters(url, userData) {
  if (!process.env.OPENAI_API_KEY)
    throw new Error('Missing OPENAI_API_KEY');

  const llm = new ChatOpenAI({
    openAIApiKey: process.env.OPENAI_API_KEY,
    modelName: 'gpt-4o-mini'
  });
  const agent = new HyperAgent({ llm });
  const page = await agent.newPage();
  await page.goto(url, { waitUntil: 'load', timeout: 60000 });

  // SmartRecruiters sometimes embeds in an iframe
  let frame = page;
  const iframe = await page.$('iframe[src*="smartrecruiters.com"]');
  if (iframe) {
    const cf = await iframe.contentFrame();
    if (cf) frame = cf;
  }

  // Wait for first‐page to appear
  await frame.waitForSelector(
    'spl-typography-title[data-test="section-title"]',
    { state: 'visible', timeout: 30000 }
  );

  // --- Upload resume if provided ---
  if (userData.resume) {
    const resumePath = fs.existsSync(path.resolve(__dirname, userData.resume))
      ? path.resolve(__dirname, userData.resume)
      : path.resolve(__dirname, 'resume.pdf');
    const dropzoneInput = await frame.$(
      'spl-dropzone[data-test="resume-upload"] input[type="file"]'
    );
    if (dropzoneInput) {
      await dropzoneInput.setInputFiles(resumePath);
      await randomDelay(frame, 500, 1000);
    }
  }

  // --- Page 1 fields ---
  // [ label‐snippet , selector‐for‐custom‐element , userData key ]
  const page1Fields = [
    ['first name', '#first-name-input', 'firstName'],
    ['last name', '#last-name-input', 'lastName'],
    ['email', '#email-input', 'email'],
    ['confirm your email', '#confirm-email-input', 'emailConfirmation'],
    ['city', '#spl-form-element_10', 'location'],
    ['phone number', '#spl-form-element_5', 'phone'],
    ['linkedin', 'input#linkedin-input', 'linkedIn'],
    ['facebook', 'input#facebook-input', 'facebook'],
    ['twitter', 'input#twitter-input', 'twitter'],
    ['website', 'input#website-input', 'website'],
    ['message to the hiring team', 'textarea#hiring-manager-message-input', 'message']
  ];

  for (const [, selector, key] of page1Fields) {
    if (!userData[key]) continue;
    const handle = await frame.$(selector);
    if (!handle) continue;
    const value = String(userData[key]);
    // Try normal fill first
    try {
      await handle.fill(value);
    } catch {
      // Fallback: JS‐inject the value and dispatch events
      await frame.evaluate(
        (sel, v) => {
          const e = document.querySelector(sel);
          if (e) {
            e.value = v;
            e.dispatchEvent(new Event('input', { bubbles: true }));
            e.dispatchEvent(new Event('change', { bubbles: true }));
          }
        },
        selector,
        value
      );
    }
    await randomDelay(frame, 200, 400);
  }

  // Go to the screening questions page
  await frame.click('oc-button[data-test="footer-next"] spl-button');
  await frame.waitForSelector(
    'sr-screening-questions-form',
    { state: 'visible', timeout: 30000 }
  );
  await randomDelay(frame, 500, 1000);

  // --- Screening questions (page 2) ---
  const questions = await frame.$$(
    'sr-screening-questions-form .form-section--clean > *:not(h2)'
  );
  const unfilled = [];

  for (const q of questions) {
    // Grab the question label
    const labelHandle =
      (await q.$('h3')) ||
      (await q.$('h4')) ||
      (await q.$('label')) ||
      (await q.$('.form-label'));
    const label = labelHandle
      ? (await labelHandle.innerText()).trim()
      : '';
    const norm = normalize(label);

    // Look up answer in userData.screening by normalized key or exact label
    let answer =
      (userData.screening || {})[norm] ||
      (userData.screening || {})[label];

    if (answer == null) {
      unfilled.push(label);
      continue;
    }
    answer = String(answer);

    // Text / number inputs
    const textInput = await q.$('input[type="text"], input[type="number"]');
    if (textInput) {
      await textInput.fill(answer);
      continue;
    }

    // <select>
    const selectEl = await q.$('select');
    if (selectEl) {
      await selectEl
        .selectOption({ label: answer })
        .catch(() => selectEl.selectOption({ value: answer }));
      continue;
    }

    // Radios
    const radios = await q.$$('input[type="radio"]');
    if (radios.length) {
      for (const r of radios) {
        const val = await r.getAttribute('value');
        if (val && val.toLowerCase() === answer.toLowerCase()) {
          await r.check({ force: true });
          break;
        }
        const id = await r.getAttribute('id');
        if (id) {
          const lab = await q.$(`label[for="${id}"]`);
          if (lab) {
            const text = await lab.innerText();
            if (normalize(text) === normalize(answer)) {
              await r.check({ force: true });
              break;
            }
          }
        }
      }
      continue;
    }

    // Checkbox
    const chk = await q.$('input[type="checkbox"]');
    if (chk) {
      const low = answer.toLowerCase();
      if (['true', 'yes', '1', 'on'].includes(low)) {
        await chk.check({ force: true });
      } else {
        await chk.uncheck({ force: true });
      }
      continue;
    }
  }

  if (unfilled.length) {
    console.log('Unfilled screening questions:', unfilled);
  }

  // If you want to *submit* at the end, uncomment the next lines:
  // await randomDelay(frame,500,800);
  // await frame.click('oc-button[data-test="footer-submit"] spl-button');
  // await page.waitForTimeout(15000);

  await agent.closeAgent();
}

module.exports = { applyToSmartRecruiters };
